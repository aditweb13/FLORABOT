# ============================================================
# FloraBOT AI — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ----- Database -----
DATABASE_URL=sqlite:///./florabot.db
# PostgreSQL example: DATABASE_URL=postgresql://user:password@localhost/florabot

# ----- File Storage -----
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports

# ----- Plant.id API (optional — vision falls back to local CV engine) -----
# Get your key at https://web.plant.id/
PLANT_ID_API_KEY=
PLANT_ID_API_URL=https://plant.id/api/v3/health_assessment

# ----- Groq API for AI Chat (optional — chatbot falls back to local botanical intelligence) -----
# Get your free key at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ----- ESP32-CAM Hardware -----
# Replace with your ESP32-CAM's actual IP address on your Wi-Fi network
CAMERA_STREAM_URL=http://192.168.1.100:81/stream
CAMERA_SNAPSHOT_URL=http://192.168.1.100/capture

# ----- Device / Monitoring Settings -----
# Seconds after last communication before a device is considered offline
DEVICE_OFFLINE_TIMEOUT_SECONDS=120
# Default periodic monitoring interval in seconds (displayed in dashboard)
MONITORING_INTERVAL_SECONDS=60
# Minimum confidence threshold to show a disease detection as confirmed
MIN_CONFIDENCE_THRESHOLD=0.35
# High confidence threshold for strong disease alerts
HIGH_CONFIDENCE_THRESHOLD=0.70

# ----- CORS (Frontend URLs allowed to call the API) -----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
